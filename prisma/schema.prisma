// Single-vendor apparel storefront.
//
// Money is stored as integer KOBO everywhere (NGN * 100). Never use Float or
// Decimal for money — kobo keeps arithmetic exact and matches what Paystack
// sends and expects on the wire.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  // NestJS compiles to CommonJS. Without this the generator emits ESM that
  // uses import.meta.url, which cannot be require()d from dist/.
  moduleFormat = "cjs"
  runtime      = "nodejs"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

model User {
  id            String  @id @default(uuid())
  email         String  @unique
  emailVerified Boolean @default(false)

  firstName   String?
  lastName    String?
  phoneNumber String?
  image       String?

  role Role @default(CUSTOMER)

  // Marketing consent is separate from account creation — a customer can have
  // an account without having opted in to broadcasts.
  acceptsMarketing Boolean @default(false)

  accountStatus       AccountStatus @default(ACTIVE)
  accountStatusReason String?

  googleId     String? @unique
  password     String?
  refreshToken String?
  provider     String  @default("local")

  mustChangePassword Boolean @default(false)

  resetOTP                   String?
  resetOTPExpiry             DateTime?
  emailVerificationOTP       String?
  emailVerificationOTPExpiry DateTime?

  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  admin         Admin?
  addresses     Address[]
  carts         Cart[]
  orders        Order[]
  reviews       Review[]
  wishlist      WishlistItem[]
  notifications Notification[]
  redemptions   DiscountRedemption[]

  @@index([role])
}

enum Role {
  CUSTOMER
  ADMIN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

model Admin {
  id     String @id @default(uuid())
  userId String @unique

  position AdminPosition @default(ADMIN)
  modules  Json          @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user           User                    @relation(fields: [userId], references: [id])
  sentBroadcasts NotificationBroadcast[]
}

enum AdminPosition {
  SUPER_ADMIN
  ADMIN
  FULFILMENT
  FINANCE
  SUPPORT
  VIEWER
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

model Category {
  id       String  @id @default(uuid())
  name     String
  slug     String  @unique
  image    String?
  position Int     @default(0)

  // Self-relation gives you Women > Dresses > Midi without a separate table.
  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")

  // Apparel-specific: a size chart shared by everything in this category.
  // Shape: { columns: string[], rows: { label: string, values: string[] }[] }
  sizeGuide Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@index([parentId])
}

// Merchandising groups that cut across the category tree: "New In",
// "Harmattan Edit", "Sale". A product can sit in many.
model Collection {
  id          String  @id @default(uuid())
  name        String
  slug        String  @unique
  description String?
  image       String?
  isActive    Boolean @default(true)
  position    Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products ProductCollection[]
}

model ProductCollection {
  productId    String
  collectionId String
  position     Int    @default(0)

  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@id([productId, collectionId])
}

model Product {
  id          String  @id @default(uuid())
  title       String
  slug        String  @unique
  description String?

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  status ProductStatus @default(DRAFT)

  // Denormalised from variants so listing pages can sort and filter on price
  // without joining. Recompute whenever a variant price changes.
  minPriceKobo Int @default(0)
  maxPriceKobo Int @default(0)

  // Apparel merchandising
  brand     String?
  material  String?
  careNotes String?
  fitNotes  String?
  tags      String[] @default([])

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  options     ProductOption[]
  variants    ProductVariant[]
  images      ProductImage[]
  collections ProductCollection[]
  reviews     Review[]
  wishlisted  WishlistItem[]

  @@index([status, publishedAt])
  @@index([categoryId])
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

// An axis of variation for one product: "Size", "Colour".
model ProductOption {
  id        String @id @default(uuid())
  productId String
  name      String
  position  Int    @default(0)

  product Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  values  ProductOptionValue[]

  @@unique([productId, name])
}

// One allowed value on an axis: "M", "Forest Green".
model ProductOptionValue {
  id       String  @id @default(uuid())
  optionId String
  value    String
  // Hex swatch for colour options; null for everything else.
  swatch   String?
  position Int     @default(0)

  option   ProductOption    @relation(fields: [optionId], references: [id], onDelete: Cascade)
  variants ProductVariant[] @relation("VariantOptionValues")

  @@unique([optionId, value])
}

// A concrete purchasable SKU: the point where Size=M meets Colour=Forest Green.
// Price and stock live here, never on Product.
model ProductVariant {
  id        String @id @default(uuid())
  productId String

  sku String @unique

  priceKobo          Int
  // Original price, shown struck through when it is above priceKobo.
  compareAtPriceKobo Int?
  // What the unit actually costs you. Admin-only; drives margin reporting.
  costKobo           Int?

  stock          Int     @default(0)
  // Allow selling past zero (pre-orders). Off by default.
  allowBackorder Boolean @default(false)
  // Surface "only 2 left" at this threshold.
  lowStockAt     Int     @default(3)

  weightGrams Int?
  barcode     String?
  image       String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product      Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  optionValues ProductOptionValue[]   @relation("VariantOptionValues")
  cartItems    CartItem[]
  orderItems   OrderItem[]
  reservations InventoryReservation[]
  movements    InventoryMovement[]

  @@index([productId])
}

model ProductImage {
  id        String  @id @default(uuid())
  productId String
  url       String
  alt       String?
  position  Int     @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

// ---------------------------------------------------------------------------
// Inventory
// ---------------------------------------------------------------------------

// Stock held for an in-flight checkout. Created when checkout begins, released
// by a sweeper once expiresAt passes, consumed when payment confirms. Available
// stock = variant.stock - SUM(active reservations).
model InventoryReservation {
  id        String @id @default(uuid())
  variantId String
  quantity  Int

  cartId  String?
  orderId String?

  expiresAt DateTime
  status    ReservationStatus @default(ACTIVE)

  createdAt DateTime @default(now())

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([status, expiresAt])
  @@index([variantId])
}

enum ReservationStatus {
  ACTIVE
  CONSUMED
  RELEASED
}

// Append-only stock ledger. Never edit variant.stock without writing one of
// these — it is the only way to answer "where did the missing units go".
model InventoryMovement {
  id        String @id @default(uuid())
  variantId String

  // Signed: negative for sales, positive for restocks and returns.
  delta          Int
  reason         InventoryReason
  // Stock level after applying delta, for point-in-time audits.
  resultingStock Int

  orderId String?
  note    String?
  actorId String?

  createdAt DateTime @default(now())

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([variantId, createdAt])
}

enum InventoryReason {
  SALE
  RESTOCK
  RETURN
  MANUAL_ADJUSTMENT
  DAMAGED
  CANCELLED_ORDER
}

// ---------------------------------------------------------------------------
// Cart
// ---------------------------------------------------------------------------

model Cart {
  id     String  @id @default(uuid())
  // Null for guests — sessionToken identifies them instead. On login, merge
  // the guest cart into the user's.
  userId String?

  sessionToken String? @unique

  status CartStatus @default(ACTIVE)

  discountId String?
  discount   Discount? @relation(fields: [discountId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@index([userId])
  @@index([status, updatedAt])
}

enum CartStatus {
  ACTIVE
  CONVERTED
  ABANDONED
}

model CartItem {
  id        String @id @default(uuid())
  cartId    String
  variantId String
  quantity  Int    @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
}

model WishlistItem {
  id        String   @id @default(uuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

// ---------------------------------------------------------------------------
// Addresses & delivery
// ---------------------------------------------------------------------------

model Address {
  id     String  @id @default(uuid())
  userId String?

  fullName    String
  phoneNumber String
  line1       String
  line2       String?
  city        String
  state       String
  country     String  @default("Nigeria")
  postalCode  String?
  // Free-text landmark. Formal addressing is unreliable in much of Nigeria and
  // dispatch riders rely on this more than the street line.
  landmark    String?

  isDefault Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Delivery pricing by area. Flat-rate shipping does not survive contact with
// Nigerian logistics — Lekki and Kano are not the same delivery.
model DeliveryZone {
  id     String   @id @default(uuid())
  name   String
  // States this zone covers, matched against Address.state.
  states String[] @default([])
  // Optional narrowing to specific cities within those states.
  cities String[] @default([])

  feeKobo Int

  // Free delivery above this subtotal. Null disables the perk.
  freeAboveKobo Int?

  estimatedMinDays Int @default(1)
  estimatedMaxDays Int @default(5)

  // Cash on delivery is a trust default in this market, but it is not viable
  // everywhere — toggle it per zone.
  allowPayOnDelivery Boolean @default(true)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shipments Shipment[]
}

// ---------------------------------------------------------------------------
// Orders
// ---------------------------------------------------------------------------

model Order {
  id String @id @default(uuid())

  // Human-facing reference used in emails and support ("NV-10432").
  orderNumber String @unique

  userId String?
  email  String

  status        OrderStatus   @default(PENDING)
  paymentStatus PaymentStatus @default(UNPAID)

  // Every amount snapshotted at purchase time. Prices, discounts and delivery
  // fees all change later; an order must always reprint exactly as it was sold.
  subtotalKobo Int
  discountKobo Int @default(0)
  deliveryKobo Int @default(0)
  totalKobo    Int

  currency String @default("NGN")

  discountId   String?
  discountCode String?

  // Frozen copy of the delivery address, not a foreign key — the customer may
  // edit or delete the Address row afterwards.
  shippingAddress Json
  billingAddress  Json?

  customerNote String?
  adminNote    String?

  placedAt     DateTime  @default(now())
  cancelledAt  DateTime?
  cancelReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User?           @relation(fields: [userId], references: [id])
  discount  Discount?       @relation(fields: [discountId], references: [id])
  items     OrderItem[]
  payments  Payment[]
  shipments Shipment[]
  returns   ReturnRequest[]
  events    OrderEvent[]

  @@index([userId])
  @@index([status])
  @@index([paymentStatus])
  @@index([placedAt])
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  UNPAID
  AWAITING_DELIVERY_PAYMENT
  PAID
  PARTIALLY_REFUNDED
  REFUNDED
  FAILED
}

model OrderItem {
  id      String @id @default(uuid())
  orderId String

  // Kept for reporting, nullable so a deleted variant never destroys an order.
  variantId String?

  // Snapshot — this is what the invoice reprints from, not the live product.
  productTitle String
  variantTitle String
  sku          String
  image        String?

  unitPriceKobo Int
  quantity      Int
  totalKobo     Int

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

// Audit trail of everything that happened to an order. Support lives in here.
model OrderEvent {
  id      String @id @default(uuid())
  orderId String

  type    OrderEventType
  message String
  data    Json?
  actorId String?

  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

enum OrderEventType {
  PLACED
  PAYMENT_INITIATED
  PAYMENT_CONFIRMED
  PAYMENT_FAILED
  STATUS_CHANGED
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
  NOTE_ADDED
}

// ---------------------------------------------------------------------------
// Payments
// ---------------------------------------------------------------------------

model Payment {
  id      String @id @default(uuid())
  orderId String

  provider PaymentProvider @default(PAYSTACK)
  method   PaymentMethod

  // Paystack transaction reference. Unique so webhook retries cannot double-pay
  // an order — the insert fails and the handler becomes idempotent for free.
  reference String @unique

  amountKobo Int
  status     PaymentTxStatus @default(PENDING)

  authorizationUrl String?
  channel          String?
  // Verbatim webhook body, kept for dispute resolution and replay.
  rawPayload       Json?

  paidAt        DateTime?
  failedAt      DateTime?
  failureReason String?

  refundedKobo Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  refunds Refund[]

  @@index([orderId])
  @@index([status])
}

enum PaymentProvider {
  PAYSTACK
  MANUAL
}

enum PaymentMethod {
  CARD
  BANK_TRANSFER
  USSD
  PAY_ON_DELIVERY
}

enum PaymentTxStatus {
  PENDING
  SUCCESS
  FAILED
  ABANDONED
}

model Refund {
  id        String @id @default(uuid())
  paymentId String

  amountKobo Int
  reason     String?
  reference  String?      @unique
  status     RefundStatus @default(PENDING)

  processedById String?
  processedAt   DateTime?

  createdAt DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
}

enum RefundStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

// ---------------------------------------------------------------------------
// Fulfilment
// ---------------------------------------------------------------------------

model Shipment {
  id      String @id @default(uuid())
  orderId String

  zoneId String?

  carrier        String?
  trackingNumber String?
  trackingUrl    String?

  status ShipmentStatus @default(PENDING)

  shippedAt   DateTime?
  deliveredAt DateTime?

  // Signature or photo captured by the rider on handover.
  proofOfDelivery String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  zone  DeliveryZone? @relation(fields: [zoneId], references: [id])

  @@index([orderId])
}

enum ShipmentStatus {
  PENDING
  READY_FOR_PICKUP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED_ATTEMPT
  RETURNED_TO_SENDER
}

// Apparel returns roughly 20-30% on size alone, so this is core, not a nicety.
model ReturnRequest {
  id      String @id @default(uuid())
  orderId String

  // [{ orderItemId, quantity, reason }]
  items Json

  reason     ReturnReason
  reasonNote String?
  status     ReturnStatus      @default(REQUESTED)
  resolution ReturnResolution?

  refundKobo Int?

  reviewedById String?
  reviewedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status])
}

enum ReturnReason {
  WRONG_SIZE
  NOT_AS_DESCRIBED
  DAMAGED
  WRONG_ITEM
  CHANGED_MIND
  OTHER
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  IN_TRANSIT
  RECEIVED
  COMPLETED
}

enum ReturnResolution {
  REFUND
  EXCHANGE
  STORE_CREDIT
}

// ---------------------------------------------------------------------------
// Discounts
// ---------------------------------------------------------------------------

model Discount {
  id   String @id @default(uuid())
  code String @unique

  type            DiscountType
  // Percent (1-100) for PERCENTAGE, kobo for FIXED_AMOUNT, ignored for
  // FREE_SHIPPING.
  value           Int
  // Ceiling on how much a PERCENTAGE discount can take off.
  maxDiscountKobo Int?

  minSubtotalKobo Int?

  // Null on both means "applies to everything".
  appliesToCollectionIds String[] @default([])
  appliesToProductIds    String[] @default([])

  usageLimit   Int?
  perUserLimit Int? @default(1)
  usedCount    Int  @default(0)

  startsAt DateTime  @default(now())
  endsAt   DateTime?
  isActive Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  carts       Cart[]
  orders      Order[]
  redemptions DiscountRedemption[]

  @@index([isActive, endsAt])
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_SHIPPING
}

model DiscountRedemption {
  id         String  @id @default(uuid())
  discountId String
  userId     String?
  orderId    String?

  amountKobo Int

  createdAt DateTime @default(now())

  discount Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
  user     User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([discountId, userId])
}

// ---------------------------------------------------------------------------
// Reviews
// ---------------------------------------------------------------------------

model Review {
  id        String @id @default(uuid())
  productId String
  userId    String

  rating Int
  title  String?
  body   String?
  images String[] @default([])

  // True when this user has a DELIVERED order containing the product.
  isVerifiedPurchase Boolean @default(false)

  // Apparel signal that drives the "runs small / true to size" widget.
  fitFeedback FitFeedback?

  status ReviewStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, userId])
  @@index([productId, status])
}

enum FitFeedback {
  RUNS_SMALL
  TRUE_TO_SIZE
  RUNS_LARGE
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

// ---------------------------------------------------------------------------
// Notifications
// ---------------------------------------------------------------------------

model Notification {
  id     String @id @default(uuid())
  userId String

  type   NotificationType
  title  String
  body   String
  data   Json?
  isRead Boolean          @default(false)

  broadcastId String?

  createdAt DateTime @default(now())

  user      User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  broadcast NotificationBroadcast? @relation(fields: [broadcastId], references: [id], onDelete: SetNull)

  @@index([userId, isRead])
}

enum NotificationType {
  ORDER_PLACED
  PAYMENT_CONFIRMED
  ORDER_SHIPPED
  ORDER_DELIVERED
  ORDER_CANCELLED
  RETURN_UPDATE
  BACK_IN_STOCK
  PRICE_DROP
  GENERAL
  ADMIN_MESSAGE
}

model NotificationBroadcast {
  id    String @id @default(uuid())
  title String
  body  String

  sendEmail   Boolean @default(false)
  actionLabel String?
  actionUrl   String?

  audienceType   BroadcastAudienceType
  filters        Json?
  recipientCount Int                   @default(0)

  sentById String

  createdAt DateTime  @default(now())
  deletedAt DateTime?

  sentBy        Admin          @relation(fields: [sentById], references: [id])
  notifications Notification[]
}

enum BroadcastAudienceType {
  INDIVIDUAL
  ALL_USERS
  ALL_CUSTOMERS
  HAS_ORDERED
  NEVER_ORDERED
  ABANDONED_CART
  FILTERED
}

// Restock alerts. Doubles as demand data: which size sold out and how many
// people wanted it is the most useful reorder signal an apparel store has.
model BackInStockAlert {
  id        String @id @default(uuid())
  variantId String
  email     String

  notifiedAt DateTime?
  createdAt  DateTime  @default(now())

  @@unique([variantId, email])
  @@index([variantId, notifiedAt])
}
