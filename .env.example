# Local development. Production values go in the hosting dashboard.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Mailjet (ELO's own account). Emails are logged, not sent, until set.
MAILJET_API_PUBLIC_KEY=
MAILJET_API_PRIVATE_KEY=
ADMIN_EMAIL_ADDRESS=
SENDER_EMAIL_ADDRESS=
SUPPORT_EMAIL_ADDRESS=
SUPPORT_PHONE_NUMBER=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

JWT_SECRET=
JWT_REFRESH_SECRET=

PORT=
NODE_ENV=
FRONTEND_URL=
BACKEND_URL=
STORE_NAME=

# Cloudflare R2 (ELO's own bucket) for admin photo uploads.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_BUCKET_NAME=
CLOUDFLARE_ACCESS_KEY_ID=
CLOUDFLARE_SECRET_ACCESS_KEY=
CLOUDFLARE_PUBLIC_URL=

# Paystack TEST secret key (sk_test_...) for development.
PAYSTACK_SECRET_KEY=

# Local test admin (created by scripts/create-admin.ts)
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
